# ==============================================================================
# Optimark Landing Page - Environment Configuration (.env.local)
# ==============================================================================
# Copy this file to .env.local for local development, or supply these
# environment variables in Docker Compose / Kubernetes for production deployment.
# ==============================================================================

# Canonical Public Website URL
# Used for metadataBase, Open Graph tags, XML sitemaps, and canonical links.
# Local development default: http://localhost:3000
# Production: https://optimark.ai
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Headless CMS API Endpoint (NestJS Backend)
# Points to the CMS Backend public endpoint.
# Local development default: http://localhost:3001
# Production example: https://api-cms.optimark.ai
CMS_API_URL="http://localhost:3001"

# Internal CMS URL (Recommended for Docker / Kubernetes networks)
# When set, Next.js server components fetch directly over the private container network
# (e.g. "http://cms-backend:3001"), bypassing reverse proxy latency and hairpin NAT.
# Leave empty for local development or if running as a standalone process.
INTERNAL_CMS_API_URL=""

# Comment Submission API (Optional)
# Defaults automatically to "${CMS_API_URL}/api/public/comments".
CMS_COMMENT_API_URL=""

# On-Demand ISR Cache Revalidation Secret
# Must match REVALIDATE_SECRET in the CMS Backend so the CMS can purge cache instantly.
REVALIDATE_SECRET="optimark_cms_revalidate_secret_2026"

# Cloudflare R2 Media CDN URL (Optional)
# In production, defaults to "https://media.optimark.ai".
# Override here if a custom media CDN domain or staging domain is used.
NEXT_PUBLIC_MEDIA_URL=""

# Anti-Spam Google reCAPTCHA v3 (Optional)
# If provided, comment submissions verify tokens against Google's verification endpoint.
RECAPTCHA_SECRET_KEY=""

# Google Analytics 4 (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
