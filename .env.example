# Copy to .env.local and fill in. .env.local is read by both Next.js and the
# Prisma CLI (prisma.config.ts).

# PostgreSQL connection for the landing-page backend.
# Local default matches docker-compose.dev.yml (`pnpm db:up`).
DATABASE_URL="postgresql://optimark:***@localhost:5433/optimark_landing?schema=public"
CMS_COMMENT_API_URL="http://localhost:3001/api/public/comments"
REVALIDATE_SECRET="optimark-secret-token"
