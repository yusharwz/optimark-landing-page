{
  "name": "landing-page",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier . --write",
    "secrets:pull": "infisical export --env=dev > .env.local",
    "secrets:pull:staging": "infisical export --env=staging > .env.local",
    "secrets:pull:prod": "infisical export --env=prod > .env.local",
    "secrets:push:dev": "infisical secrets set --file=.env.local --env=dev",
    "secrets:push:staging": "infisical secrets set --file=.env.local --env=staging",
    "secrets:push:prod": "infisical secrets set --file=.env.local --env=prod"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-aria/utils": "^3.33.1",
    "@react-stately/utils": "^3.11.0",
    "@react-types/shared": "^3.33.1",
    "@untitledui/icons": "^0.0.21",
    "clsx": "^2.1.1",
    "framer-motion": "^12.36.0",
    "gsap": "^3.15.0",
    "input-otp": "^1.4.2",
    "lenis": "^1.3.18",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.8",
    "react": "19.2.3",
    "react-aria": "^3.47.0",
    "react-aria-components": "^1.16.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-stately": "^3.45.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prettier": "^3.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "sharp",
      "unrs-resolver"
    ]
  },
  "optionalDependencies": {
    "@parcel/watcher-darwin-x64": "^2.6.0"
  }
}
